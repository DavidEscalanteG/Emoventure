[sub_resource type="Shader" id="Shader_halo_personaje"]
code = "shader_type canvas_item;

void fragment() {
    vec2 centered = (UV - vec2(0.5)) * 2.0;
    float radius = length(centered);
    float glow = (1.0 - smoothstep(0.12, 0.96, radius)) * 0.32;
    float ring = (1.0 - smoothstep(0.01, 0.038, abs(radius - 0.73))) * 0.45;
    float inner_ring = (1.0 - smoothstep(0.01, 0.024, abs(radius - 0.57))) * 0.12;
    float alpha = (glow + ring + inner_ring) * (1.0 - smoothstep(0.88, 1.0, radius));
    COLOR = vec4(0.27, 0.74, 0.89, alpha);
}"

