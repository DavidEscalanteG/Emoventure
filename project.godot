; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Emoventure"
run/main_scene="res://scenes/menu_principal/menu_principal.tscn"
config/features=PackedStringArray("4.5", "Mobile")
config/icon="res://scenes/mision_3_hachas/icon.svg"

[autoload]

SaveManager="*res://scenes/src/autoload/save_manager.gd"
GameManager="*res://scenes/src/autoload/game_manager.gd"
MusicManager="*res://scenes/src/autoload/music_manager.gd"
MobileControlsSettings="*res://scenes/src/autoload/mobile_controls_settings.gd"
DatosJugador="*res://scenes/src/autoload/datos_jugador.gd"
AudioManager="*res://scenes/src/autoload/audio_manager.gd"
Cuestionarios="*res://scenes/src/autoload/cuestionarios.gd"
DialogueActors="*res://scenes/src/autoload/dialogue_actors.gd"
Logs="*res://scenes/src/autoload/Logs.gd"
PauseOverlayManager="*res://scenes/src/autoload/pause_overlay_manager.gd"
PauseOverlay="*res://scenes/src/ui/pause_overlay.tscn"
MobileControls="*res://scenes/src/ui/mobile_controls.tscn"

[dialogue_manager]

runtime/balloon_path="res://assets/dialogos/balloon.tscn"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/window_width_override=1920
window/size/window_height_override=1080
window/stretch/mode="canvas_items"

[editor_plugins]

enabled=PackedStringArray("res://addons/curve_snapper/plugin.cfg", "res://addons/dialogue_manager/plugin.cfg")

[global_group]

enemigos="Enemigos del juego del laberinto"

[gui]

theme/custom="res://assets/temas/tema_global_fuente.tres"

