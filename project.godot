[internationalization]

locale/translations_pot_files=PackedStringArray("res://dialogos/escena_1.dialogue", "res://dialogos/escena_5.dialogue", "res://dialogos/escena_6.dialogue", "res://dialogos/escena_7.dialogue", "res://dialogos/escena_2.dialogue", "res://dialogos/escena_8.dialogue", "res://dialogos/escena_13.dialogue")

[layer_names]

2d_physics/layer_1="Jugador"
2d_physics/layer_2="Enemigos"
2d_physics/layer_3="Intersecciones"
2d_physics/layer_4="Pared"

[rendering]

textures/canvas_textures/default_texture_filter=0
renderer/rendering_method="mobile"
textures/vram_compression/import_etc2_astc=true
