; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Emoventure"
run/main_scene="uid://cxv23v4515m48"
config/features=PackedStringArray("4.5", "Mobile")
config/icon="res://icon.svg"

[autoload]

DialogueManager="*res://addons/dialogue_manager/dialogue_manager.gd"
Global="*res://Scripts/Globales/DatosJugador.gd"
GameManager="*res://Scripts/Globales/GameManager.gd"
DialogueActors="*res://Scripts/Globales/DialogueActors.gd"

[dialogue_manager]

runtime/balloon_path="res://assets/dialogos/balloon.tscn"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/window_width_override=1920
window/size/window_height_override=1080
window/stretch/mode="canvas_items"

[editor_plugins]

enabled=PackedStringArray("res://addons/dialogue_manager/plugin.cfg")

[global_group]

enemigos="Enemigos del juego del laberinto"

